# Stackd production — settings of the API (services `api` and `migrate` only). Copy to
# `stackd.env`, run ./init-env.sh to fill the generated secrets, keep it mode 0600 and back it up:
# losing STACKD_ENCRYPTION_KEY makes every stored secret unreadable.
#
# The API refuses to start in production unless: STACKD_ENCRYPTION_KEY is a base64 32-byte key,
# STACKD_JWT_SECRET has ≥ 32 characters, the public URL is https, STACKD_ALLOWED_DOMAINS is not
# empty, and the OIDC signer is `kms` (or STACKD_ALLOW_LOCAL_SIGNER=true).
# Leave optional settings commented out rather than empty.

STACKD_ENV=production
STACKD_LOG_FORMAT=json
STACKD_LOG_LEVEL=INFO

# ── Database (PostgreSQL 18 — required for the native uuidv7()) ────────────────────────────
# External server (recommended): postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB (URL-encode the
# password). With the bundled-postgres profile, init-env.sh writes the URL of the container.
DATABASE_URL=
# Audit retention purge (SPECS §6.1, §7.5): a connection as the `stackd_audit_purge` role
# (created NOLOGIN by the migrations — give it LOGIN and a password, see the guide). Unset = no
# purge runs; the audit trail is kept forever.
#STACKD_AUDIT_PURGE_DATABASE_URL=postgresql+asyncpg://stackd_audit_purge:PASSWORD@HOST:5432/DB
#AUDIT_RETENTION_DAYS=730
#LOG_HOT_RETENTION_DAYS=7

# ── Secrets (generated by init-env.sh — never rotate the encryption key in place) ───────────
# AES-256-GCM master key: base64 of 32 random bytes.
STACKD_ENCRYPTION_KEY=
# Session JWT signing secret: at least 32 characters.
STACKD_JWT_SECRET=

# ── Google sign-in (the only login in production) ───────────────────────────────────────────
# OAuth client of type "Web application", authorized redirect URI:
#   https://<STACKD_DOMAIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace domains (`hd` claim) allowed to sign in, comma-separated. Required.
STACKD_ALLOWED_DOMAINS=example.com

# ── Object storage (any S3-compatible service; a dedicated bucket, versioning ON) ────────────
S3_BUCKET=stackd
# Static access key of a principal limited to this bucket (the API does not use the AWS default
# credential chain for S3).
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_REGION=eu-west-1
# Only for a non-AWS S3 (MinIO, Garage, Ceph, R2…): its endpoint. Unset = AWS S3.
#S3_ENDPOINT_URL=https://s3.example.internal

# ── Workload OIDC issuer signing key (SPECS §10) ────────────────────────────────────────────
# Recommended: an AWS KMS asymmetric key (RSA_2048, SIGN_VERIFY) — the private key never leaves
# KMS. The API calls KMS with the AWS default credential chain (instance role, or the
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below) and needs kms:Sign + kms:GetPublicKey on it.
STACKD_OIDC_SIGNER=kms
STACKD_OIDC_KMS_KEY_ARN=arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# Alternative: a local RSA key, AES-GCM encrypted in the database with the master key. Requires
# this explicit acknowledgement in production.
#STACKD_OIDC_SIGNER=local
#STACKD_ALLOW_LOCAL_SIGNER=true

# ── URLs ────────────────────────────────────────────────────────────────────────────────────
# STACKD_PUBLIC_URL is set by compose from STACKD_DOMAIN (.env).
# Where workers' tofu reaches the state backend (/state/v1). Default: the public URL, which works
# for workers on any host. Single-host only alternative: http://api:8000 with the worker's
# STACKD_DOCKER_NETWORK=stackd_agents (see the guide).
#STACKD_INTERNAL_URL=http://api:8000
# Base of the deep links in notifications. Default: the public URL (the SPA is on the same origin).
#STACKD_APP_URL=
# GitHub Enterprise API base for PR post-back.
#STACKD_GITHUB_API_URL=https://api.github.com

# ── Observability ───────────────────────────────────────────────────────────────────────────
# OTLP/HTTP endpoint: set → traces exported.
#STACKD_OTLP_ENDPOINT=http://otel-collector:4318

# ── Timings & guardrails (defaults shown) ───────────────────────────────────────────────────
#STACKD_HEARTBEAT_INTERVAL=20
#STACKD_WORKER_OFFLINE_SECONDS=60
#STACKD_WORKER_LOST_SECONDS=120
#STACKD_APPLY_TIMEOUT_SECONDS=900
#STACKD_APPLY_LOST_GRACE_SECONDS=300
#STACKD_HEAD_POLL_INTERVAL=900
#STACKD_APPLY_AFFINITY_SECONDS=60
#STACKD_DRIFT_INTERVAL_SECONDS=21600
#STACKD_ROLLOUT_APPROVAL_TTL_SECONDS=86400
#ACCESS_TOKEN_TTL_SECONDS=900
#REFRESH_TOKEN_TTL_SECONDS=1209600
#WORKER_TOKEN_TTL_SECONDS=86400
#STACKD_DISCOVERY_MAX_REPO_MB=200
#STACKD_DISCOVERY_MAX_TF_FILES=500

# Never in production: STACKD_DEV_AUTH (refused at startup, and the module is not in the image).
