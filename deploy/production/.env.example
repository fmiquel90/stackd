# Stackd production — compose-level settings (read by `docker compose` for interpolation; no
# container receives this file as a whole). Copy to `.env`.
#
# Who gets what:
#   .env         (this file)  docker compose itself; a few values are passed on explicitly
#   stackd.env   api + migrate — every platform secret lives there
#   worker.env   worker only — never a platform secret

# ── Main host ──────────────────────────────────────────────────────────────────────────────

# Public host name (DNS → this host). The proxy obtains its certificate; the api derives
# STACKD_PUBLIC_URL=https://$STACKD_DOMAIN from it.                          → proxy, api
STACKD_DOMAIN=stackd.example.com
# Only when the public URL is not https://$STACKD_DOMAIN (e.g. a non-443 port).  → api
#STACKD_PUBLIC_URL=https://stackd.example.com
# Extra Caddy global options: the ACME account email, or `local_certs` for Caddy's internal CA
# (tests, private networks — browsers will not trust it).                      → proxy
CADDY_GLOBAL_OPTIONS=email ops@example.com
# Published ports of the proxy (both needed for automatic HTTPS).               → proxy
#STACKD_HTTP_PORT=80
#STACKD_HTTPS_PORT=443

# Images (build them with `task build-images`, or your registry's references — pin by digest).
STACKD_API_IMAGE=stackd/api:latest
STACKD_FRONT_IMAGE=stackd/front:latest
STACKD_WORKER_IMAGE=stackd/worker:latest

# Optional profiles: `bundled-postgres` (a PostgreSQL 18 container here instead of an external
# server) and `worker` (a worker on this host, once a pool exists). Comma-separated.
COMPOSE_PROFILES=
# Password of the bundled PostgreSQL (profile bundled-postgres); init-env.sh generates it and
# writes the matching DATABASE_URL into stackd.env.                            → postgres
POSTGRES_PASSWORD=

# API processes (uvicorn workers). Each opens its own DB pool; the rate limits are per process.
#STACKD_API_PROCESSES=2
# Subnet of the `edge` network (proxy, front, api). The api trusts X-Forwarded-* from it only.
# Change it if it collides with a network of the host.
#STACKD_EDGE_SUBNET=172.31.250.0/24

# ── Worker host (also the main host with the `worker` profile) ──────────────────────────────

# Host directory for the job workspaces, mounted at the SAME path in the worker container (the
# job containers bind-mount it by host path). Created by Docker if missing.      → worker
#STACKD_WORKSPACE_ROOT=/var/lib/stackd/workspaces
