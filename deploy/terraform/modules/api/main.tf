# The API on ECS Fargate behind an internal ALB.
#
#   CloudFront (VPC origin) ──HTTPS──▶ ALB :443 (ACM certificate of internal_domain_name)
#   workers                 ──HTTPS──▶ ALB :443
#   ALB ──HTTPS──▶ API task :8443 (self-signed certificate generated by the image at start:
#                                  the ALB does not verify target certificates, but no hop of the
#                                  path is plain text)
#
# There is no plain-HTTP listener. Until `enabled` (an API image is given) only the ALB, the
# cluster and the log group exist: the bootstrap apply creates no service.

locals {
  container_port = 8443

  environment = [for k, v in var.environment : { name = k, value = v }]
  secrets     = [for k, v in var.secrets : { name = k, valueFrom = v }]
  # The migration needs no Google credential: it can run before the client secret is set.
  migrate_secrets = [for k, v in var.secrets : { name = k, valueFrom = v } if k != "GOOGLE_CLIENT_SECRET"]
}

resource "aws_cloudwatch_log_group" "api" {
  name              = "/stackd/${var.name}/api"
  retention_in_days = var.log_retention_days
}

# ── Security groups (ingress to the ALB: root module) ─────────────────────────────────────────

resource "aws_security_group" "alb" {
  name        = "${var.name}-alb"
  description = "Stackd internal ALB: HTTPS from CloudFront VPC origin ENIs and workers"
  vpc_id      = var.vpc_id
}

resource "aws_security_group" "api" {
  name        = "${var.name}-api"
  description = "Stackd API tasks"
  vpc_id      = var.vpc_id
}

resource "aws_vpc_security_group_egress_rule" "alb_to_api" {
  security_group_id            = aws_security_group.alb.id
  referenced_security_group_id = aws_security_group.api.id
  from_port                    = local.container_port
  to_port                      = local.container_port
  ip_protocol                  = "tcp"
  description                  = "To the API tasks"
}

resource "aws_vpc_security_group_ingress_rule" "api_from_alb" {
  security_group_id            = aws_security_group.api.id
  referenced_security_group_id = aws_security_group.alb.id
  from_port                    = local.container_port
  to_port                      = local.container_port
  ip_protocol                  = "tcp"
  description                  = "From the internal ALB"
}

# Out: RDS, S3 (gateway endpoint), KMS, Secrets Manager, STS, Google, git remotes, webhooks.
resource "aws_vpc_security_group_egress_rule" "api_all" {
  security_group_id = aws_security_group.api.id
  cidr_ipv4         = "0.0.0.0/0"
  ip_protocol       = "-1"
  description       = "Outbound (AWS APIs, Google, git remotes, notifications, RDS)"
}

# ── Internal ALB ─────────────────────────────────────────────────────────────────────────────

resource "aws_lb" "api" {
  name               = "${var.name}-api"
  internal           = true
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = var.subnet_ids

  drop_invalid_header_fields = true
  # The claim long-poll holds a request ~25 s; WebSockets stay open.
  idle_timeout               = 120
  enable_deletion_protection = var.alb_deletion_protection
}

resource "aws_lb_target_group" "api" {
  name                 = "${var.name}-api"
  port                 = local.container_port
  protocol             = "HTTPS"
  vpc_id               = var.vpc_id
  target_type          = "ip"
  deregistration_delay = 30

  health_check {
    protocol            = "HTTPS"
    path                = "/healthz"
    matcher             = "200"
    healthy_threshold   = 2
    unhealthy_threshold = 3
    interval            = 15
  }
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.api.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.certificate_arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.api.arn
  }
}

# ── ECS ──────────────────────────────────────────────────────────────────────────────────────

resource "aws_ecs_cluster" "this" {
  name = var.name

  setting {
    name  = "containerInsights"
    value = "enabled"
  }
}

resource "aws_ecs_cluster_capacity_providers" "this" {
  cluster_name       = aws_ecs_cluster.this.name
  capacity_providers = ["FARGATE"]

  default_capacity_provider_strategy {
    capacity_provider = "FARGATE"
    weight            = 1
  }
}

resource "aws_ecs_task_definition" "api" {
  count = var.enabled ? 1 : 0

  family                   = "${var.name}-api"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.cpu
  memory                   = var.memory
  execution_role_arn       = var.execution_role_arn
  task_role_arn            = var.task_role_arn

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = var.cpu_architecture
  }

  container_definitions = jsonencode([{
    name      = "api"
    image     = var.image
    essential = true
    command   = ["serve"]

    portMappings = [{ containerPort = local.container_port, protocol = "tcp" }]

    environment = local.environment
    secrets     = local.secrets

    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.api.name
        "awslogs-region"        = var.region
        "awslogs-stream-prefix" = "api"
      }
    }

    healthCheck = {
      command = [
        "CMD", "python", "-c",
        "import ssl, urllib.request; urllib.request.urlopen('https://localhost:${local.container_port}/healthz', context=ssl._create_unverified_context(), timeout=4)",
      ]
      interval    = 15
      timeout     = 5
      retries     = 3
      startPeriod = 30
    }
  }])
}

resource "aws_ecs_service" "api" {
  count = var.enabled ? 1 : 0

  name             = "${var.name}-api"
  cluster          = aws_ecs_cluster.this.id
  task_definition  = aws_ecs_task_definition.api[0].arn
  desired_count    = var.desired_count
  launch_type      = "FARGATE"
  platform_version = "LATEST"

  deployment_minimum_healthy_percent = 100
  deployment_maximum_percent         = 200
  health_check_grace_period_seconds  = 60

  network_configuration {
    subnets          = var.subnet_ids
    security_groups  = [aws_security_group.api.id]
    assign_public_ip = false
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.api.arn
    container_name   = "api"
    container_port   = local.container_port
  }

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  # The schema first: a new image rolls out only once its migrations have run.
  depends_on = [aws_lb_listener.https, terraform_data.migrate]
}
